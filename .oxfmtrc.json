{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "dist/**",
    "release/**",
    "output/**",
    ".cache/**",
    ".sites-runtime/**",
    "coverage/**",
    ".nyc_output/**",
    "licenses/**",
    "pnpm-lock.yaml"
  ]
}
