{
	"name": "qmplay",
	"productName": "qmplay",
	"version": "1.0.0",
	"private": true,
	"description": "qmplay, a minimal QQ Music player for Linux, Windows and Android.",
	"type": "module",
	"main": "electron/main.cjs",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"start": "node scripts/start.mjs",

		"check": "node scripts/check.mjs",

		"build": "node scripts/build.mjs && electron-builder --dir",
		"build:linux": "node scripts/build-linux.mjs",
		"build:windows": "node scripts/build-windows.mjs",
		"build:android": "node scripts/build-android.mjs",

		"test": "node scripts/test.mjs",
		"test:ci": "node scripts/test.mjs --ci",
		"test:integration": "node scripts/test-integration.mjs"
	},
	"devDependencies": {
		"@electron/asar": "3.4.1",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"@jixun/qmweb-sign": "2.0.3",
		"axios": "1.13.6",
		"koa": "2.16.4",
		"koa-bodyparser": "4.3.0",
		"koa-router": "7.4.0",
		"lodash.get": "4.4.2",
		"zod": "4.3.6",
		"esbuild": "0.28.2",
		"typescript": "^5.9.3",
		"@types/koa": "^3.0.2",
		"@types/koa-router": "^7.4.9",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/node": "^25.5.0",
		"@types/lodash.get": "^4.4.9"
	},
	"build": {
		"appId": "app.qmplay",
		"productName": "qmplay",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron/*.cjs",
			"package.json",
			"THIRD_PARTY_NOTICES.md",
			"licenses/**/*"
		],
		"win": {
			"target": ["nsis", "portable"],
			"icon": "assets/icon.png",
			"requestedExecutionLevel": "asInvoker"
		},
		"nsis": {
			"artifactName": "${name}-${version}-win-${arch}-setup.${ext}",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"installerLanguages": ["zh_CN", "en_US"],
			"shortcutName": "qmplay",
			"deleteAppDataOnUninstall": false
		},
		"portable": {
			"artifactName": "${name}-${version}-win-${arch}-portable.${ext}",
			"requestExecutionLevel": "user"
		},
		"linux": {
			"target": [
				"deb",
				"rpm",
				"AppImage"
			],
			"category": "Audio",
			"icon": "assets/icon.png",
			"maintainer": "qmplay",
			"artifactName": "${name}-${version}-${arch}.${ext}",
			"synopsis": "Minimal QQ Music player for Linux",
			"desktop": {
				"entry": {
					"Name": "qmplay",
					"Comment": "QQ Music player",
					"Categories": "AudioVideo;Audio;Player;"
				}
			},
			"syncDesktopName": true
		}
	},
	"config": {
		"electron_mirror": "https://npmmirror.com/mirrors/electron/",
		"electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
	},
	"homepage": "https://github.com/eric-wenyv/qmplay",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/eric-wenyv/qmplay.git"
	},
	"bugs": {
		"url": "https://github.com/eric-wenyv/qmplay/issues"
	},
	"desktopName": "qmplay.desktop"
}
