{
	"name": "qqmui",
	"productName": "qqmui",
	"version": "1.0.0",
	"private": true,
	"description": "qqmui (qq music ui), a minimal QQ Music player for Linux.",
	"type": "module",
	"main": "electron/main.cjs",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"start": "node scripts/start.mjs",
		"test": "node --test tests/*.test.js",
		"check": "node scripts/check.mjs",
		"build": "node scripts/build.mjs",
		"pack:dir": "pnpm build && electron-builder --dir",
		"dist:linux": "node scripts/build-linux.mjs",
		"dev:ui": "node scripts/serve.mjs",
		"test:integration": "node scripts/test-integration.mjs",
		"build:backend": "node scripts/build-backend.mjs",
		"build:linux": "node scripts/build-linux.mjs",
		"build:android": "node scripts/build-android.mjs",
		"install:android": "node scripts/build-android.mjs --install"
	},
	"devDependencies": {
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"@jixun/qmweb-sign": "2.0.3",
		"axios": "1.13.6",
		"koa": "2.16.4",
		"koa-bodyparser": "4.3.0",
		"koa-router": "7.4.0",
		"lodash.get": "4.4.2",
		"zod": "4.3.6",
		"esbuild": "0.28.2",
		"typescript": "^5.9.3",
		"@types/koa": "^3.0.2",
		"@types/koa-router": "^7.4.9",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/node": "^25.5.0",
		"@types/lodash.get": "^4.4.9"
	},
	"build": {
		"appId": "app.qqmui",
		"productName": "qqmui",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json",
			"THIRD_PARTY_NOTICES.md",
			"licenses/**/*"
		],
		"linux": {
			"target": [
				"deb",
				"rpm",
				"AppImage"
			],
			"category": "Audio",
			"icon": "assets/icon.png",
			"maintainer": "qqmui",
			"artifactName": "${name}-${version}-${arch}.${ext}",
			"synopsis": "Minimal QQ Music player for Linux",
			"desktop": {
				"entry": {
					"Name": "qqmui",
					"Comment": "QQ Music player",
					"Categories": "AudioVideo;Audio;Player;"
				}
			},
			"syncDesktopName": true
		}
	},
	"config": {
		"electron_mirror": "https://npmmirror.com/mirrors/electron/",
		"electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
	},
	"homepage": "https://github.com/eric-wenyv/qmui",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/eric-wenyv/qmui.git"
	},
	"bugs": {
		"url": "https://github.com/eric-wenyv/qmui/issues"
	},
	"desktopName": "qqmui.desktop"
}
